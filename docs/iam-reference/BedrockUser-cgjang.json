{
  "RoleName": "BedrockUser-admin",
  "Arn": "arn:aws:iam::<ACCOUNT_ID>:role/BedrockUser-admin",
  "MaxSessionDuration": 3600,
  "AssumeRolePolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": [
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-ComputeFleetQueuesNe-RoleEXAMPLE",
            "arn:aws:iam::<ACCOUNT_ID>:role/acme-ora-RoleHeadNode-NoBedrock",
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-ComputeFleetQueuesNe-RoleE023cc478a73ac4b-t59JrlvQNSsR",
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-ComputeFleetQueuesNe-RoleEXAMPLE",
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-ComputeFleetQueuesNe-RoleEXAMPLE",
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-ComputeFleetQueuesNe-RoleEXAMPLE",
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-RoleHeadNode-EXAMPLE",
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-ComputeFleetQueuesNe-RoleFddf5a48e958cde0-PnbZiKu1235l",
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-ComputeFleetQueuesNe-RoleD4a04feab6af0c39-NQldLulTWEGn",
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-ComputeFleetQueuesNe-RoleE9d20843b98a0ad6-9o5EnlM6C07N",
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-ComputeFleetQueuesNe-RoleEXAMPLE",
            "arn:aws:iam::<ACCOUNT_ID>:role/parallelcluster/acme-ora/acme-ora-ComputeFleetQueuesNe-RoleEXAMPLE"
          ]
        },
        "Action": "sts:AssumeRole"
      }
    ]
  },
  "InlinePolicies": {
    "AllowDevGatewayApprovalRequest": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "execute-api:Invoke",
          "Resource": [
            "arn:aws:execute-api:us-west-2:<ACCOUNT_ID>:<GATEWAY_API_ID>/v1/POST/approval/request"
          ]
        }
      ]
    },
    "AllowDevGatewayConverse": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "execute-api:Invoke",
          "Resource": [
            "arn:aws:execute-api:us-west-2:<ACCOUNT_ID>:<GATEWAY_API_ID>/v1/POST/converse"
          ]
        }
      ]
    },
    "AllowDevGatewayQuotaStatus": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "execute-api:Invoke",
          "Resource": [
            "arn:aws:execute-api:us-west-2:<ACCOUNT_ID>:<GATEWAY_API_ID>/v1/GET/quota/status"
          ]
        }
      ]
    },
    "AllowDiscoveryGatewayInvoke": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "AllowDiscoveryGatewayInvoke",
          "Effect": "Allow",
          "Action": "execute-api:Invoke",
          "Resource": [
            "arn:aws:execute-api:us-west-2:<ACCOUNT_ID>:<DISCOVERY_API_ID>/v1/*/*"
          ]
        }
      ]
    },
    "BedrockAccess": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "bedrock:InvokeModel",
            "bedrock:InvokeModelWithResponseStream",
            "bedrock:Converse",
            "bedrock:ConverseStream"
          ],
          "Resource": [
            "arn:aws:bedrock:*::foundation-model/anthropic.claude*",
            "arn:aws:bedrock:*::foundation-model/amazon.*",
            "arn:aws:bedrock:*:<ACCOUNT_ID>:inference-profile/*"
          ]
        },
        {
          "Effect": "Allow",
          "Action": [
            "bedrock:ListFoundationModels",
            "bedrock:GetFoundationModel",
            "bedrock:ListInferenceProfiles",
            "bedrock:GetInferenceProfile",
            "bedrock:InvokeAgent"
          ],
          "Resource": "*"
        }
      ]
    },
    "DenyDirectBedrockInference": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "DenyDirectBedrockAccess",
          "Effect": "Deny",
          "Action": [
            "bedrock:InvokeModel",
            "bedrock:InvokeModelWithResponseStream",
            "bedrock:Converse",
            "bedrock:ConverseStream"
          ],
          "Resource": "*"
        }
      ]
    },
    "DenyDirectECSAndSFN": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "DenyDirectECSAndSFN",
          "Effect": "Deny",
          "Action": [
            "ecs:RunTask",
            "ecs:ExecuteCommand",
            "ecs:StartTask",
            "states:StartExecution",
            "states:StartSyncExecution"
          ],
          "Resource": "*"
        }
      ]
    },
    "S3DataAccess": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "s3:GetObject",
            "s3:PutObject",
            "s3:DeleteObject",
            "s3:ListBucket",
            "s3:GetBucketLocation"
          ],
          "Resource": [
            "arn:aws:s3:::*",
            "arn:aws:s3:::*/*"
          ]
        }
      ]
    }
  }
}